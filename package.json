{
  "name": "i18n-collect-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "serve": "npm run serve -w i18n-auto-webpack-demo",
    "build": "npm run build -w i18n-auto-webpack-demo",
    "update-demo-collection": "npm run collect -w i18n-auto-webpack-demo",
    "build-vue3-demo": "npm run build -w i18n-auto-webpack-vue3-demo",
    "update-vue3-demo-collection": "npm run collect -w i18n-auto-webpack-vue3-demo",
    "build-react-demo": "npm run build -w i18n-auto-webpack-react-demo",
    "update-react-demo-collection": "npm run collect -w i18n-auto-webpack-react-demo",
    "regression": "npm test && npm run build && npm run build-vue3-demo && npm run build-react-demo && node scripts/verify-hybrid-localization.js --skip-package-tests",
    "lint": "npm run lint -w i18n-auto-webpack-demo",
    "test": "npm test -w i18n-collect",
    "verify": "node scripts/verify-hybrid-localization.js"
  }
}
