{
  "name": "i18n-auto-webpack-vue3-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "collect": "node ../../packages/i18n-collect/bin/i18n-collect.js collect",
    "collect:watch": "node ../../packages/i18n-collect/bin/i18n-collect.js collect --watch",
    "build": "node ../../packages/i18n-collect/bin/i18n-collect.js build",
    "watch": "node ../../packages/i18n-collect/bin/i18n-collect.js build --watch",
    "review": "node ../../packages/i18n-collect/bin/i18n-collect.js review",
    "translate": "node ../../packages/i18n-collect/bin/i18n-collect.js translate",
    "replace": "node ../../packages/i18n-collect/bin/i18n-collect.js replace --adapter vue3",
    "scan": "node ../../packages/i18n-collect/bin/i18n-collect.js scan",
    "check": "node ../../packages/i18n-collect/bin/i18n-collect.js check"
  },
  "dependencies": {
    "i18n-collect": "0.1.0",
    "vue": "3.5.42",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@vue/compiler-sfc": "3.5.42",
    "css-loader": "^6.7.3",
    "html-webpack-plugin": "^5.5.1",
    "less": "^4.2.0",
    "less-loader": "^10.2.0",
    "sass": "^1.77.8",
    "sass-loader": "^10.5.2",
    "style-loader": "^3.3.2",
    "stylus": "^0.64.0",
    "stylus-loader": "^8.1.1",
    "vue-loader": "17.1.0",
    "webpack": "^5.82.1",
    "webpack-cli": "^4.10.0"
  }
}
