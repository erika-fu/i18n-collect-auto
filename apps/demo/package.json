{
  "name": "i18n-auto-webpack-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "collect": "node ../../packages/i18n-collect/bin/i18n-collect.js collect",
    "collect:watch": "node ../../packages/i18n-collect/bin/i18n-collect.js collect --watch",
    "build": "node ../../packages/i18n-collect/bin/i18n-collect.js build",
    "watch": "node ../../packages/i18n-collect/bin/i18n-collect.js build --watch",
    "translate": "node ../../packages/i18n-collect/bin/i18n-collect.js translate",
    "replace": "node ../../packages/i18n-collect/bin/i18n-collect.js replace --adapter vue2",
    "scan": "node ../../packages/i18n-collect/bin/i18n-collect.js scan",
    "check": "node ../../packages/i18n-collect/bin/i18n-collect.js check",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "core-js": "^3.8.3",
    "i18n-collect": "0.1.0",
    "vue": "^2.6.14",
    "vue-i18n": "8.28.2"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "less": "^4.2.0",
    "less-loader": "^10.2.0",
    "sass": "^1.77.8",
    "sass-loader": "^10.5.2",
    "stylus": "^0.64.0",
    "stylus-loader": "^8.1.1",
    "vue-template-compiler": "^2.6.14",
    "webpack-cli": "^4.10.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
